generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  name         String
  createdAt    DateTime  @default(now())
  projects     Project[]
}

model Template {
  id           String    @id @default(uuid())
  title        String
  description  String
  category     String
  partyTag     String    @default("All Parties")
  width        Int
  height       Int
  thumbnailUrl String
  canvasData   Json
  isPublished  Boolean   @default(true)
  createdAt    DateTime  @default(now())
  projects     Project[]
}

model Project {
  id           String    @id @default(uuid())
  name         String
  width        Int
  height       Int
  canvasData   Json      @default("{}")
  thumbnailUrl String?
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  templateId   String?
  template     Template? @relation(fields: [templateId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}
